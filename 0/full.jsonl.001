: Promise<Record<string, unknown> | null>;\n    listRecords(resource: string): Promise<Record<string, unknown>[]>;\n    upsertRecord(resource: string, record: Record<string, unknown>): Promise<void>;\n    deleteRecord(resource: string, id: string): Promise<void>;\n    /**\n     * Atomic read-modify-write merge. MUST be linearizable across every adapter\n     * instance through a backend transaction or equivalent coordination primitive.\n     * If the record does not exist, creates from `options.ifMissing` when\n     * supplied, otherwise from `partial`.\n     * Uses one-level-deep merge for object-type fields.\n     */\n    mergeRecord(resource: string, id: string, partial: Record<string, unknown>, \n    /** Complete creation payload used instead of `partial` when absent. */\n    options?: {\n        ifMissing?: Record<string, unknown>;\n    }): Promise<Record<string, unknown>>;\n    listJoinRows(relationKey: string): Promise<Array<Record<string, unknown>>>;\n    getJoinRows(relationKey: string, fromId: string): Promise<Array<Record<string, unknown>>>;\n    getJoinRowsInverse(relationKey: string, toId: string): Promise<Array<Record<string, unknown>>>;\n    upsertJoinRow(relationKey: string, row: Record<string, unknown>): Promise<void>;\ntype StringSelectToken<Q> = Extract<SelectToken<Q>, string>;\ntype SelectedFieldName<Q> = Exclude<StringSelectToken<Q>, \"*\" | `${string}.${string}`>;\ntype HasWildcardSelect<Q> = Extract<StringSelectToken<Q>, \"*\"> extends never ? false : true;\ntype HasSelect<Q> = Q extends {\n    readonly select: readonly unknown[];\n} ? true : false;\ntype SelectedRecord<TRecord, Q> = HasSelect<Q> extends false ? TRecord : HasWildcardSelect<Q> extends true ? TRecord & Record<string, unknown> : [SelectedFieldName<Q>] extends [never] ? Partial<TRecord> & Record<string, unknown> : Pick<TRecord, Extract<keyof TRecord, SelectedFieldName<Q>>> & Partial<TRecord> & Record<Exclude<SelectedFieldName<Q>, keyof TRecord>, unknown>;\ntype DatafnQueryResult<TRecord, Q> = Q extends {\n    readonly aggregations: Record<string, unknown>;\n} ? {\n    data: Array<Record<string, unknown>>;\n    count?: number;\n    nextCursor?: string | null;\n} : {\n    data: Array<SelectedRecord<TRecord, Q>>;\n    count?: number;\n    nextCursor?: string | null;\n};\ntype DatafnSignalValue<TRecord, Q> = Q extends {\n    readonly count: true;\n} ? {\n    count?: number;\n    data?: Array<SelectedRecord<TRecord, Q>>;\n} | Array<SelectedRecord<TRecord, Q>> : Q extends {\n    readonly aggregations: Record<string, unknown>;\n} ? Array<Record<string, unknown>> : Array<SelectedRecord<TRecord, Q>>;\ninterface DatafnTable<S extends DatafnSchema = DatafnSchema, Name extends string = DatafnResourceName<S>, TRecord = DatafnResourceRecord<S, Name>> {\n    name: Name;\n    version: number;\n    query<const Q extends DatafnTableQueryFragment<TRecord>>(q: Q): Promise<DatafnQueryResult<TRecord, Q>>;\n    select<const O extends SelectOptions | undefined = undefined>(id: string, options?: O): Promise<SelectedRecord<TRecord, O> | undefined>;\n    mutate(m: DfqlMutationFragment | DfqlMutationFragment[]): Promise<unknown>;\n    delete(id: string): Promise<unknown>;\n    trash?: (id: string) => Promise<unknown>;\n    restore?: (id: string) => Promise<unknown>;\n    archive?: (id: string) => Promise<unknown>;\n    unarchive?: (id: string) => Promise<unknown>;\n    share?: {\n        (id: string, userId: string, level: string): Promise<unknown>;\n        (input: PrincipalShareMutationInput): Promise<unknown>;\n    };\n    unshare?: {\n        (id: string, userId: string): Promise<unknown>;\n        (input: PrincipalUnshareMutationInput): Promise<unknown>;\n    };\n    getPermissions?: (id: string) => Promise<PermissionEntry[]>;\n    transact(payload: DfqlTransact): Promise<unknown>;\n    signal<const Q extends DatafnTableQueryFragment<TRecord>>(q: Q, options?: DatafnSignalOptions): DatafnSignal<DatafnSignalValue<TRecord, Q>>;\n    relation(relationName: string): {\n        query<const Q extends DatafnRelationQueryFragment>(id: string, q?: Q): Promise<DatafnQueryResult<Record<string, unknown>, Q>>;\n        signal<const Q extends DatafnRelationQueryFragment>(id: string, q?: Q, options?: DatafnSignalOptions): DatafnSignal<DatafnSignalValue<Record<string, unknown>, Q>>;\n    };\n    subscribe(handler: EventHandler, filter?: EventFilter): () => void;\n}\n\ntype CloneUpOptions = {\n    resources?: string[];\n    includeManyMany?: boolean;\n    recordOperation?: \"merge\" | \"replace\" | \"insert\";\n    batchSize?: number;\n    maxRetries?: number;\n    failFast?: boolean;\n    clearChangelogOnSuccess?: boolean;\n    setGlobalCursorOnSuccess?: boolean;\n    pullAfter?: boolean;\n    mutationIdPrefix?: string;\n    create(input: CreateDatafnPublicLinkInput): Promise<DatafnPublicLinkGrant>;\n    revoke(input: {\n        id: string;\n    }): Promise<void>;\n    resolve(input: {\n        token: string;\n    }): Promise<DatafnResolvedPublicLink>;\n    principalId(linkId: string): string;\n    authPlugin: typeof createDatafnPublicLinkAuthPlugin;\n}\n\n/**\n * DataFn client factory\n */\n\ntype IsAny<T> = 0 extends 1 & T ? true : false;\ntype SchemaResources<S extends DatafnSchema> = DatafnSchemaLiteral<S> extends {\n    readonly resources: readonly (infer Resource)[];\n} ? Resource : S extends {\n    readonly resources: readonly (infer Resource)[];\n} ? Resource : never;\ntype ResourceNames<S extends DatafnSchema> = IsAny<S> extends true ? string : DatafnSchema extends S ? string : SchemaResources<S> extends infer Resource ? Resource extends {\n    readonly name: infer Name extends string;\n} ? Name : never : never;\ninterface DatafnRemoteAdapter {\n    query(q: unknown): Promise<unknown>;\n    mutation(m: unknown): Promise<unknown>;\n    transact(t: unknown): Promise<unknown>;\n    seed(payload: unknown): Promise<unknown>;\n    clone(payload: unknown): Promise<unknown>;\n    pull(payload: unknown): Promise<unknown>;\n    push(payload: 