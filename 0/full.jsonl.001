ences(\n+        userPreferencesSignal.get() ?? seedUserPreferences\n+      );\n+      userPreferencesLocal.set(\n+        applyOptimisticKvEntries(current, pendingUserPreferenceValues)\n+      );\n+    };\n+    void mutation.then((result) => {\n+      if (!result.ok) rollbackPendingValues();\n+    }, rollbackPendingValues);\n+    return mutation;\n   },\n","move_path":null},"/Users/serro/Documents/dev/n/nucleus-pr-570-review/client/stores/actionMap.ts":{"type":"update","unified_diff":"@@ -605,3 +605,3 @@\n   {\n-    action: \"combination-create\",\n+    action: \"combination_create\",\n     component: CreateCombination,\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /Users/serro/Documents/dev/n/nucleus-pr-570-review/client/components/settings/userPreferences.store.ts\nM /Users/serro/Documents/dev/n/nucleus-pr-570-review/client/stores/actionMap.ts\n","stderr":""},"started_at_ms":1788142813251,"completed_at_ms":1788142813253}}
