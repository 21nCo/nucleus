nly\", \"cached-cloud\"].includes(\n      resolution.status\n    );\n  }\n\n  isCloudUserAndOffline() {\n    const account = this.get();\n    const ctx = get(context);\n    if (account.dataMode === UserDataMode.CLOUD && ctx.isInOfflineMode)\n      return true;\n    return false;\n  }\n\n  isCloudUserAndOnline() {\n    const account = this.get();\n    const ctx = get(context);\n    if (account.dataMode === UserDataMode.CLOUD && !ctx.isInOfflineMode)\n      return true;\n    return false;\n  }\n}\n\nconst account = new AccountStore();\nexport default account;\n","exit_code":0,"duration":{"secs":0,"nanos":2333},"formatted_output":"36:  clearDatafnLocalData,\n38:  destroyNucleumDatafn\n233:      await destroyNucleumDatafn();\n420:        await clearDatafnLocalData();\n428:        \"v2/account/deleteAccount\",\n441:      await clearDatafnLocalData();\n468:      ).deleteAccount();\n515:      if (isOffline) return { status: \"unavailable\" as const };\n518:        return { status: \"unavailable\" as const };\n539:      return { status: \"unavailable\" as const, error: e };\n747:      isReturnUrl?: boolean;\n810:          isReturnUrl: params.isReturnUrl\n827:            isReturnUrl: params.isReturnUrl\n869:        if (params.isReturnUrl) {\n874:        const mutationResult = (await datafn.file.mutate({\n898:    isReturnUrl?: boolean;\n900:    if (params.isReturnUrl) {\n901:      return URL.createObjectURL(params.blob);\n903:    const arrayBuffer = await params.blob.arrayBuffer();\n904:    const uint8Array = new Uint8Array(arrayBuffer);\n907:      const thumbnailArrayBuffer = await params.thumbnailBlob.arrayBuffer();\n923:    const mutationResult = (await datafn.file.mutate({\n951:  async checkIfSessionExpired() {\n953:    return ![\"authenticated\", \"offline-only\", \"cached-cloud\"].includes(\n      email,\n      nickName: metadata.nucleus?.nickName ?? email.split(\"@\")[0] ?? \"\",\n      joinDate: new Date(),\n      lastLogin: new Date(),\n      profilePictureUrl: metad