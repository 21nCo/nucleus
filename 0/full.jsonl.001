afnRemoteAdapter, type DatafnResolvedPublicLink, type DatafnResourceCountsSignalInput, type DatafnRpcEvent, type DatafnRpcMethod, type DatafnRpcRequest, type DatafnRpcResponse, type DatafnRpcSubscribePayload, type DatafnRpcUnsubscribePayload, type DatafnSearchParams, type DatafnSearchResult, type DatafnSignalCacheOptions, type DatafnSignalOptions, type DatafnStorageAdapter, type DatafnStorageAdapterCapabilities, type DatafnStorageFactory, type DatafnSyncConfig, type DatafnSyncMode, type DatafnSyncOwner, type DatafnSyncPhase, type DatafnSyncStatus, type DatafnSyncStatusKind, type DatafnTable, type DatafnTemporalApi, type DatafnTemporalChangeSource, EventBus, type EventFilter, type EventHandler, type ExtensionRemoteAdapter, ExtensionSubscriptionManager, type ExtensionTransportOptions, IndexedDbStorageAdapter, MemoryStorageAdapter, type MessageBus, type PermissionEntry, type RecordTimezoneChangeInput, type RemoteSubscriptionAdapter, type SwitchContextOverride, type SyncControlMethods, combineSignals, createClientError, createDatafnClient, createDatafnPublicLinkAuthPlugin, createExtensionTransport, emptySignal, mapSignal, matchesFilter, parseDateFields, parseQueryResultDates, serializeDateFields, throwClientError, unwrapRemoteSuccess };\n\ntype DatafnHttpHeaders = HeadersInit | null | undefined | (() => HeadersInit | null | undefined | Promise<HeadersInit | null | undefined>);\ninterface DatafnHttpTransportOptions {\n    fetch?: typeof fetch;\n    headers?: DatafnHttpHeaders;\n    credentials?: RequestCredentials;\n    auth?: HttpTransportAuthProvider;\n    onError?(event: HttpTransportErrorEvent): void;\n}\n\n/**\n * KV API implementation for datafn\n * Provides a first-class key-value store that works with signals and events.\n */\n\ninterface DatafnKvApi {\n    get<T = unknown>(key: string): Promise<T | null>;\n    set<T = unknown>(key: string, value: T, params?: {\n        context?: Record<string, unknown>;\n        debounceMs?: number;\n    }): Promise<{\n        ok: true;\n        key: string;\n    } | {\n        ok: false;\n        error: unknown;\n    }>;\n    merge(key: string, patch: Record<string, unknown>, params?: {\n        context?: Record<string, unknown>;\n        debounceMs?: number;\n    }): Promise<{\n        ok: true;\n        key: string;\n    } | {\n        ok: false;\n        error: unknown;\n    }>;\n    delete(key: string, params?: {\n        context?: Record<string, unknown>;\n    }): Promise<{\n        ok: true;\n        key: string;\n    } | {\n        ok: false;\n        error: unknown;\n    }>;\n    getOrSeed<T = unknown>(key: string, defaults: T): Promise<T>;\n    flush(key?: string): Promise<void>;\n    signal<T = unknown>(key: string, options?: {\n        defaultValue?: T;\n        cache?: DatafnSignalCacheOptions;\n    }): DatafnSignal<T>;\n}\n\ntype DatafnTemporalChangeSource = \"manual\" | \"browser\" | \"system\" | \"import\" | string;\ntype RecordTimezoneChangeInput = {\n    timezone: string;\n    effectiveFrom?: number | string | Date;\n    recordedAt?: number | string | Date;\n    source?: DatafnTemporalChangeSource;\n};\ninterface DatafnTemporalApi {\n    detectTimezone(): string | undefined;\n    listTimezoneChanges(): Promise<DatafnTimezoneChangeRecord[]>;\n    currentTimezone(instant?: number | string | Date): Promise<string>;\n    resolveTimezone(instant?: number | string | Date): Promise<string>;\n    recordTimezoneChange(input: RecordTimezoneChangeInput): Promise<{\n        ok: true;\n        record: DatafnTimezoneChangeRecord;\n    } | {\n        ok: false;\n        error: unknown;\n    }>;\n    setTimezone(timezone: string, options?: Omit<RecordTimezoneChangeInput, \"timezone\">): Promise<{\n        ok: true;\n        changed: boolean;\n        record?: DatafnTimezoneChangeRecord;\n    } | {\n        ok: false;\n        error: unknown;\n    }>;\n    resolveRange(period: DatafnTemporalPeriodInput, options?: {\n        timezone?: string;\n        instant?: number | string | Date;\n    }): Promise<{\n        start: number;\n        end: number;\n        timezone: string;\n    }>;\n    resolveRangeSync(period: DatafnTemporalPeriodInput, options?: {\n        timezone?: string;\n        instant?: number | string | Date;\n    }): {\n        start: number;\n        end: number;\n        timezone: string;\n"},{"type":"input_text","text":"## resource_actions\nclient/data/datafn/resource.utils.ts:19:export function resourceAction(resource: Resource, action: ResourceActionType) {\nclient/components/goals/goal.store.ts:664:  const resourceActions = new ResourceActions(goal as unknown as IGoal, goalStore, {\nclient/components/flux/resourceStores/resource.utils.ts:17:export function resourceAction(resource: Resource, action: ResourceActionType) {\nclient/components/collection/collection.store.ts:580:  const resourceActions = new ResourceActions(collection, collectionStore, {\nclient/components/tasks/task.store.ts:193:  const resourceActions = new ResourceActions(task, taskStore, {\nclient/products/product-nav.config.ts:22:const resourceActionId = (resource: string, action: string) =>\nclient/products/memotron/node/node.store.ts:924:  const resourceActions = new ResourceActions(node, nodeStore, {\nclient/stores/actionMap.ts:606:    action: \"combination-create\",\nclient/products/nucleus/nucleus.actions.ts:64:    action: resourceAction(Resource.combination, ResourceActionType.BROWSE),\nclient/components/combination/CreateCombination.svelte:95:    action={resourceAction(Resource.combination, ResourceActionType.CREATE)}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0558f-6735-7503-8564-a5536fbbea25","create_time":1788142744.429908}}}
