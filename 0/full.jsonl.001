.error(`Plugin ${plugin.name}.${String(hookName)} error:`, err);\\n    }\\n  }\\n\\n  return currentResult;\\n}\\n\"]}\n","stderr":"","aggregated_output":"node_modules/@datafn/client/dist/index.d.ts:226:type SelectOptions = {\nnode_modules/@datafn/core/dist/index.d.ts:285:type DfqlQueryFragment = Omit<DfqlQuery, \"resource\" | \"version\">;\nnode_modules/@datafn/core/dist/index.d.ts:633:export { type BeforeHookResult, DATAFN_E2EE_ENVELOPE_MARKER, type DatafnE2eeCipherEnvelope, DatafnEnvelope, DatafnFieldSchema, DatafnHookContext, DatafnPlugin, type DatafnPublicLinkSchemaOptions, type DatafnRelationDirection, type DatafnRelationEndpoint, type DatafnRelationFkField, type DatafnRelationMatch, DatafnRelationSchema, type DatafnResolvedTemporalGroup, DatafnResourceSchema, DatafnSchema, type DatafnTemporalBucketInput, type DatafnTemporalClause, type DatafnTemporalConfig, type DatafnTemporalDateParts, type DatafnTemporalGroupInput, type DatafnTemporalLocalTimeInput, type DatafnTemporalPeriodInput, type DatafnTemporalRangeInput, type DatafnTemporalScale, type DatafnTemporalStorage, type DatafnTemporalTimezoneResolver, type DatafnTimezoneChangeRecord, type DfqlCursor, type DfqlMutation, type DfqlMutationFragment, type DfqlQuery, type DfqlQueryFragment, type DfqlRelationPayload, type DfqlRelationRef, type DfqlRelations, type DfqlSort, type DfqlTransact, type DfqlTransactStep, type FilterEvalOptions, type HookError, KV_RESOURCE_NAME, OP_REMAP, PUBLIC_LINK_RESOURCE_NAME, RelationSimpleCapability, type SchemaIndex, type SearchProvider, type SelectToken, SortInputTerm, TIMEZONE_CHANGE_ID_PREFIX, TIMEZONE_CHANGE_RESOURCE_NAME, addTemporalPeriod, buildSchemaIndex, calculateAggregation, checkPrototypePollution, coerceDateFieldsToEpoch, createBuiltinPublicLinkResource, createTemporalPlugin, createTimezoneResolver, dfqlKey, endpointIncludes, endpointList, ensureBuiltinKv, ensureBuiltinPublicLinks, ensureBuiltinTemporal, enumerateJoinStoreKeys, evaluateFilter, findRelationBidirectional,