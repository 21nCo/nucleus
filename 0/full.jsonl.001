ibes.forEach((unsubscribe) => unsubscribe());\n        signals.forEach((signal) => signal.dispose());\n      };\n    });\n    return () => {\n      unsubscribeClient();\n      disposeSignals();\n    };\n  });\n\n  function replaceResourceCount(resource: string, count: number) {\n    cache.replace(`${resource}-${CacheKey.COUNT}`, count);\n    const legacyResource = {\n      objective: Resource.goal,\n      space: Resource.combination,\n      linkTag: Resource.relation\n    }[resource];\n    if (legacyResource) {\n      cache.replace(resourceCacheKey(legacyResource, CacheKey.COUNT), count);\n    }\n  }\n</script>\n\n<div>\n  {#each components as item (item.action)}\n    {@const Component = item.component}\n    <Component {...item.componentParams} />\n  {/each}\n</div>\nclient/stores/actionMap.ts:44:import { resourceCacheComponentKey } from \"@21n/components/flux/resourceStores/resource.utils\";\nclient/stores/actionMap.ts:997:    action: resourceCacheComponentKey(LegacyResource.collection),\nclient/products/pointron/pointron.actions.ts:65:  resourceCacheComponentKey,\nclient/products/pointron/pointron.actions.ts:686:    action: resourceCacheComponentKey(Resource.goal),\nclient/products/pointron/pointron.actions.ts:694:    action: resourceCacheComponentKey(Resource.task),\nclient/components/flux/resourceStores/resource.utils.ts:21:export function resourceCacheComponentKey(resource: Resource) {\nclient/layout/layers/cache/cache.type.ts:7:  TYPED_COLLECTION_CACHE = \"typed-collection-cache\"\nclient/layout/layers/cache/InMemoryCache.svelte:9:    resourceCacheComponentKey,\nclient/layout/layers/cache/InMemoryCache.svelte:20:    resourceCacheComponentKey(Resource.collection)\nclient/products/memotron/memotron.actions.ts:18:  resourceCacheComponentKey\nclient/products/memotron/memotron.actions.ts:268:    action: resourceCacheComponentKey(Resource.node),\nclient/products/memotron/memotron.actions.ts:276:    action: resourceCacheComponentKey(Resource.relation),\nclient/stores