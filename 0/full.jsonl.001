t.reviewThreads.nodes' > \\\"$snapshot_dir/thread-page.json\\\"\\n  jq -s '.[0] + .[1]' \\\"$snapshot_dir/threads.json\\\" \\\"$snapshot_dir/thread-page.json\\\" > \\\"$snapshot_dir/threads-complete.json\\\"\\n  mv \\\"$snapshot_dir/threads-complete.json\\\" \\\"$snapshot_dir/threads.json\\\"\\n  has_next=$(printf '%s' \\\"$page\\\" | jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage')\\n  cursor=$(printf '%s' \\\"$page\\\" | jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.endCursor')\\ndone\\nrm -f \\\"$snapshot_dir/thread-page.json\\\"\\nGH_CONFIG_DIR=/Users/serro/.config/gh-other gh api --paginate --slurp 'repos/21nCo/nucleum/pulls/570/reviews?per_page=100' | jq 'add' > \\\"$snapshot_dir/reviews.json\\\"\\nGH_CONFIG_DIR=/Users/serro/.config/gh-other gh api --paginate --slurp 'repos/21nCo/nucleum/issues/570/comments?per_page=100' | jq 'add' > \\\"$snapshot_dir/issue-comments.json\\\"\\nGH_CONFIG_DIR=/Users/serro/.config/gh-other gh api --paginate --slurp 'repos/21nCo/nucleum/pulls/570/comments?per_page=100' | jq 'add' > \\\"$snapshot_dir/inline-comments.json\\\"\\nGH_CONFIG_DIR=/Users/serro/.config/gh-other gh pr view 570 --repo 21nCo/nucleum --json number,url,state,isDraft,headRefName,headRefOid,baseRefName,baseRefOid,mergeable,mergeStateStatus,updatedAt > \\\"$snapshot_dir/pr.json\\\"\\nhead_sha=$(jq -r '.headRefOid' \\\"$snapshot_dir/pr.json\\\")\\njq -n --arg snapshotDir \\\"$snapshot_dir\\\" --arg head \\\"$head_sha\\\" --argjson threads \\\"$(jq 'length' \\\"$snapshot_dir/threads.json\\\")\\\" --argjson unresolved \\\"$(jq '[.[] | select(.isResolved == false)] | length' \\\"$snapshot_dir/threads.json\\\")\\\" --argjson currentUnresolved \\\"$(jq --arg head \\\"$head_sha\\\" '[.[] | select(.isResolved == false) | select(any(.comments.nodes[]; .commit.oid == $head and (.outdated == false)))] | length' \\\"$snapshot_dir/threads.json\\\")\\\" --argjson commentOverflowThreads \\\"$(jq '[.[] | select(.comments.pageInfo.hasNextPage =