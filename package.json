{
  "name": "@21n/nucleus",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "extensions/*",
    "services/*",
    "client/stores",
    "client/components",
    "client/elements",
    "client/utils",
    "client/actions",
    "client/products",
    "client/features",
    "client/datafn",
    "client/static",
    "client/layout",
    "client/persistence",
    "client/extensions",
    "client/branding",
    "client/icons",
    "client/theme",
    "client/legacy",
    "client/illustrations",
    "client/iconsV2",
    "shared/utils",
    "shared/dbo",
    "schema",
    "tests",
    "client/application",
    "client"
  ],
  "dependencies": {
    "@carbon/charts": "1.22.18",
    "@carbon/charts-svelte": "1.22.18",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.5",
    "@types/cookie": "^0.6.0",
    "@types/markdown-it": "^14.1.2",
    "cookie": "^0.6.0",
    "fake-indexeddb": "^6.0.0",
    "jiti": "^2.6.1",
    "mrmime": "^2.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "sade": "^1.8.1",
    "sirv": "^3.0.1",
    "svelte": "^5.55.0",
    "svelte-preprocess": "^5.1.1",
    "ts-morph": "^22.0.0",
    "tslib": "^2.8.0",
    "tsx": "^4.19.1",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.5"
  },
  "scripts": {
    "build": "turbo run build",
    "check:apps": "node tools/check/run-app-checks.mjs --format=json",
    "check:no-fixed-test-waits": "node tools/check/no-fixed-test-waits.mjs",
    "check:no-legacy-runtime": "node tools/check/no-legacy-runtime.mjs",
    "dev": "turbo run dev --parallel",
    "dev:nucleus": "turbo run dev --filter=nucleus-app",
    "dev:memotron": "turbo run dev --filter=memotron-app",
    "dev:gathery": "turbo run dev --filter=gathery-app",
    "dev:pointron": "turbo run dev --filter=pointron-app",
    "dev:memotron-share": "turbo run dev --filter=memotron-share",
    "dev:memotron-clipper": "turbo run dev --filter=memotron-clipper",
    "codemod:alias": "tsx tools/codemods/alias-migration/index.ts",
    "lint": "npm run check:architecture && npm run check:no-fixed-test-waits && turbo run lint",
    "test": "turbo run test --filter=tidigit-tests",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:products": "turbo run build --filter='./apps/*'",
    "build:nucleus": "turbo run build --filter=nucleus-app",
    "build:memotron": "turbo run build --filter=memotron-app",
    "build:pointron": "turbo run build --filter=pointron-app",
    "build:ios": "npm run build:ios:dev",
    "build:ios:local": "npm run build:ios:nucleum:local && npm run build:ios:memotron:local && npm run build:ios:pointron:local",
    "build:ios:dev": "npm run build:ios:nucleum:dev && npm run build:ios:memotron:dev && npm run build:ios:pointron:dev",
    "build:ios:pre": "npm run build:ios:nucleum:pre && npm run build:ios:memotron:pre && npm run build:ios:pointron:pre",
    "build:ios:live": "npm run build:ios:nucleum:live && npm run build:ios:memotron:live && npm run build:ios:pointron:live",
    "build:ios:nucleum": "npm run build:ios:nucleum:dev",
    "build:ios:nucleum:local": "node tools/ios/build-web-bundle.mjs nucleum -- --mode local",
    "build:ios:nucleum:dev": "node tools/ios/build-web-bundle.mjs nucleum -- --mode dev",
    "build:ios:nucleum:pre": "node tools/ios/build-web-bundle.mjs nucleum -- --mode pre",
    "build:ios:nucleum:live": "node tools/ios/build-web-bundle.mjs nucleum -- --mode live",
    "build:ios:memotron": "npm run build:ios:memotron:dev",
    "build:ios:memotron:local": "node tools/ios/build-web-bundle.mjs memotron -- --mode local",
    "build:ios:memotron:dev": "node tools/ios/build-web-bundle.mjs memotron -- --mode dev",
    "build:ios:memotron:pre": "node tools/ios/build-web-bundle.mjs memotron -- --mode pre",
    "build:ios:memotron:live": "node tools/ios/build-web-bundle.mjs memotron -- --mode live",
    "build:ios:pointron": "npm run build:ios:pointron:dev",
    "build:ios:pointron:local": "node tools/ios/build-web-bundle.mjs pointron -- --mode local",
    "build:ios:pointron:dev": "node tools/ios/build-web-bundle.mjs pointron -- --mode dev",
    "build:ios:pointron:pre": "node tools/ios/build-web-bundle.mjs pointron -- --mode pre",
    "build:ios:pointron:live": "node tools/ios/build-web-bundle.mjs pointron -- --mode live",
    "setup:ios:whisper": "node tools/ios/setup-whisper.mjs",
    "build:memotron-share": "turbo run build --filter=memotron-share",
    "clean": "turbo run clean",
    "check:architecture": "node tools/check/architecture.mjs"
  },
  "packageManager": "npm@10.0.0",
  "overrides": {
    "@babel/traverse": "7.29.0",
    "@parcel/watcher": "2.1.0"
  }
}
