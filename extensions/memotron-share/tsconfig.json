{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "types": [
      "svelte",
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "vite.config.ts",
    "../../client/ambient/**/*.d.ts"
  ],
  "exclude": [
    "../../node_modules",
    "../../**/node_modules",
    "../../tests/**/*",
    "../*/build/**/*",
    "../*/dist/**/*",
    "../*/.svelte-kit/**/*",
    "build/**/*",
    "dist/**/*",
    ".svelte-kit/**/*"
  ]
}
