{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "types": [
      "svelte",
      "vite/client"
    ]
  },
  "include": [
    "../../client/ambient/**/*.d.ts",
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "vite.config.js",
    "vite.config.ts"
  ],
  "exclude": [
    "../../node_modules",
    "../../**/node_modules",
    "../../deployment/**/*",
    "../../server/**/*",
    "../../tests/**/*",
    "../nucleus/**/*",
    "../pointron/**/*",
    "build/**/*",
    "dist/**/*",
    ".svelte-kit/**/*",
    "../../packages/static/**/*"
  ]
}
