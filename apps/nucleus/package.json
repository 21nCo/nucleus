    "@types/node": "^22.9.1",
    "@vercel/analytics": "^1.0.2",
    "autoprefixer": "^10.4.13",
    "axe-playwright": "^1.2.3",
    "chromatic": "^10.0.0",
    "eslint": "^8.57.0",
