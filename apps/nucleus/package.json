{
  "name": "nucleus-app",
  "version": "0.4.0",
  "build": 4,
  "private": true,
  "scripts": {
    "dev": "vite dev --port 5050",
    "debug": "vite dev --host 0.0.0.0 --port 5050",
    "debug-two": "vite dev --host 0.0.0.0 --port 5051",
    "debug-three": "vite dev --host 0.0.0.0 --port 5052",
    "debug-pre": "vite dev --host 0.0.0.0 --port 5100 --mode pre",
    "debug-live": "vite dev --host 0.0.0.0 --port 5200 --mode live",
    "build": "VITE_BUILD_DATE=$(date +%m%d) NODE_OPTIONS=\"--max-old-space-size=8192\" vite build",
    "build-on-windows": "for /f \"tokens=2 delims==\" %i in ('wmic OS Get localdatetime /value') do set dt=%i && set VITE_BUILD_DATE=%dt:~4,2%%dt:~6,2% && set NODE_OPTIONS=--max-old-space-size=8192 && vite build",
    "build-vercel": "VITE_BUILD_DATE=$(date +%m%d) NODE_OPTIONS=\"--max-old-space-size=8192\" vite build",
    "build-pre": "VITE_BUILD_DATE=$(date +%m%d) NODE_OPTIONS=\"--max-old-space-size=8192\" vite build --mode pre",
    "build-pre-windows": "for /f \"tokens=2 delims==\" %i in ('wmic OS Get localdatetime /value') do set dt=%i && set VITE_BUILD_DATE=%dt:~4,2%%dt:~6,2% && vite build --mode pre",
    "build-live-windows": "for /f \"tokens=2 delims==\" %i in ('wmic OS Get localdatetime /value') do set dt=%i && set VITE_BUILD_DATE=%dt:~4,2%%dt:~6,2% && vite build --mode live",
    "build-live": "VITE_BUILD_DATE=$(date +%m%d) NODE_OPTIONS=\"--max-old-space-size=8192\" vite build --mode live",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --browsers firefox chromium webkit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.0",
    "@iconify/tailwind": "^1.1.3",
    "@playwright/test": "^1.49.0",
    "@storybook/addon-a11y": "^8.6.15",
    "@storybook/addon-coverage": "^1.0.0",
